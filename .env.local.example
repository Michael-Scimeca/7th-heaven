# ── Primary Domain & Canonical URL ──
# Set to your live production URL (e.g., https://7thheavenband.com)
NEXT_PUBLIC_SITE_URL=https://7thheavenband.com

# ── Supabase (Auth + Database) ──
# Get these from https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Upstash Redis (Rate Limiting) ──
# Get these from https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Google Maps (Tour Map on Hero / Tour page) ──
# Get a key from https://console.cloud.google.com/google/maps-apis/credentials
# Enable the "Maps JavaScript API" for the project. Restrict the key to your
# site's domain(s) under "Application restrictions" → "Websites".
# Do NOT set a Map ID for this key/map — the Snazzy Maps JSON style in
# TourMap.tsx only applies when no Map ID is configured.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── hCaptcha (Bot Protection) ──
# Get these from https://dashboard.hcaptcha.com
NEXT_PUBLIC_HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# ── Role Bootstrapping ──
# Comma-separated email lists. Only consulted on NEW account creation (signup / first OAuth).
# After the first login, profiles.role in Supabase is the sole authority.
# Example: ADMIN_EMAILS=alice@example.com,bob@example.com
ADMIN_EMAILS=
CREW_EMAILS=
MERCH_EMAILS=
PLANNER_EMAILS=
CRUISE_EMAILS=

# ── Admin Notifications ──
# Email address that receives booking confirmations, new-account alerts, etc.
ADMIN_ALERT_EMAIL=
ADMIN_EMAIL=

# ── North (EPX) Browser Post API — /payment-test shop ──
# Set to true to simulate checkout without real credentials (no EPX calls).
NORTH_MOCK_MODE=false
# Get these from North's integration team. Give them this REDIRECT_URL:
#   <NEXT_PUBLIC_SITE_URL>/api/payment-test/north/result
MAC=
TRAN_GROUP=SALE
NEXT_PUBLIC_NORTH_CUST_NBR=
NEXT_PUBLIC_NORTH_DBA_NBR=
NEXT_PUBLIC_NORTH_MERCH_NBR=
NEXT_PUBLIC_NORTH_TERMINAL_NBR=
NEXT_PUBLIC_NORTH_INDUSTRY_TYPE=E
NEXT_PUBLIC_NORTH_TRAN_CODE=SALE

# ── Email System & Resend (Free Quota: 100/day, 3000/month) ──
# Get your API key from https://resend.com/api-keys
# Domain MUST be verified in Resend (SPF & DKIM DNS records required).
# Add DMARC TXT record: "v=DMARC1; p=none; rua=mailto:dmarc@7thheavenband.com"
RESEND_API_KEY=
EMAIL_FROM=7th Heaven <news@7thheavenband.com>
EMAIL_REPLY_TO=info@7thheavenband.com
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000

# ── Web Push Notifications (VAPID / Web-Push) ──
# Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@7thheavenband.com

# ── ntfy.sh Push Notifications (free — https://ntfy.sh) ──
# Sent from the admin dashboard (Send Alert / Broadcast) as a free instant channel.
# Private topics (CREW, BAND, ADMINS) must be long random strings (e.g. openssl rand -hex 12).
# FANS topic can be public for fans to subscribe in the ntfy mobile app.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC_FANS=
NTFY_TOPIC_CREW=
NTFY_TOPIC_BAND=
NTFY_TOPIC_ADMINS=
NTFY_TOPIC_CRUISE=

# ── SMS Fallback (Twilio — Paid, Off by Default) ──
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Estimated cost per SMS segment for admin preview calculation
SMS_COST_PER_MESSAGE=0.0079

# ── Shopify Storefront Integration ──
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
NEXT_PUBLIC_DISABLE_SHOPIFY=false

# ── Supabase Admin Service Key ──
SUPABASE_SERVICE_ROLE_KEY=

# ── LiveKit Streaming & Audio Rooms ──
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Sanity CMS Configuration ──
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_TOKEN=
SANITY_REVALIDATE_SECRET=
SANITY_WEBHOOK_SECRET=
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# ── Additional Notifications & Emails ──
ADMIN_NOTIFICATION_EMAIL=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_NTFY_TOPIC_FANS=
NEXT_PUBLIC_NTFY_TOPIC_CREW=
NEXT_PUBLIC_NTFY_TOPIC_BAND=
NEXT_PUBLIC_NTFY_TOPIC_CRUISE=

# ── Analytics & Payments ──
NEXT_PUBLIC_GA_ID=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ── System Secrets & Security Keys ──
CRON_SECRET=
HIVE_MODERATION_API_KEY=
NEXT_PUBLIC_SHOW_DEV_NAV=false
ADMIN_API_SECRET=
CREW_CALENDAR_SECRET=
CRUISE_ENCRYPTION_KEY=


