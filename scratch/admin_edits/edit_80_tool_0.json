    "ReplacementContent": "                        <input\n                          type=\"text\"\n                          value={drawerCrewSearch}\n                          onChange={e => setDrawerCrewSearch(e.target.value)}\n                          placeholder=\"🔍 Search crew members...\"\n                          className=\"w-full px-3 py-1.5 bg-black/40 border border-white/10 text-xs text-white placeholder-white/30 rounded-lg outline-none focus:border-amber-500/50 transition-colors font-bold font-sans\"\n                        />\n                        \n                        {/* Crew Groups selection chips and Create Group */}\n                        <div className=\"border border-white/5 bg-black/20 rounded-xl p-3 space-y-2.5\">\n                          <div className=\"flex items-center justify-between\">\n                            <span className=\"text-[10px] font-black text-white/60 uppercase tracking-wider\">Crew Groups</span>\n                            {!isSavingGroup ? (\n                              <button\n                                type=\"button\"\n                                onClick={() => setIsSavingGroup(true)}\n                                className=\"text-[9px] font-black text-amber-400 hover:text-amber-300 transition-colors bg-transparent border-none p-0 cursor-pointer uppercase tracking-wider flex items-center gap-1\"\n                              >\n                                <span>➕ Create Group</span>\n                              </button>\n                            ) : (\n                              <button\n                                type=\"button\"\n                                onClick={() => setIsSavingGroup(false)}\n                                className=\"text-[9px] font-bold text-white/40 hover:text-white/70 transition-colors bg-transparent border-none p-0 cursor-pointer\"\n                              >\n                                Cancel\n                              </button>\n                            )}\n                          </div>\n\n                          {isSavingGroup && (\n                            <div className=\"flex items-center gap-2 animate-[fadeIn_0.15s_ease] bg-black/40 border border-white/10 p-2 rounded-lg\">\n                              <input\n                                type=\"text\"\n                                value={newGroupName}\n                                onChange={e => setNewGroupName(e.target.value)}\n                                placeholder=\"Group name (e.g. Stage Crew)\"\n                                className=\"flex-1 px-2.5 py-1 bg-black border border-white/15 text-[10px] text-white placeholder-white/20 rounded outline-none focus:border-amber-500/50 transition-colors font-bold\"\n                              />\n                              <button\n                                type=\"button\"\n                                onClick={handleSaveGroup}\n                                disabled={!newGroupName.trim() || !Object.values(selectedCrewAssignments).some(a => a.active)}\n                                className=\"px-2.5 py-1 bg-amber-500 hover:bg-amber-400 disabled:bg-amber-500/20 disabled:text-white/30 text-black font-black text-[9px] uppercase tracking-wider rounded transition-colors cursor-pointer border-none\"\n                              >\n                                Save\n                              </button>\n                            </div>\n                          )}\n\n                          <div className=\"flex flex-wrap gap-1.5\">\n                            {crewGroups.length === 0 ? (\n                              <span className=\"text-[9px] text-white/30 italic\">No custom groups created yet</span>\n                            ) : (\n                              crewGroups.map(group => {\n                                const isSelected = group.memberIds.every(id => selectedCrewAssignments[id]?.active) && \n                                  Object.entries(selectedCrewAssignments).filter(([_, a]) => a.active).length === group.memberIds.length;\n                                return (\n                                  <div\n                                    key={group.name}\n                                    className={`flex items-center border rounded-full px-2.5 py-1 transition-all text-[10px] font-extrabold cursor-pointer ${\n                                      isSelected\n                                        ? 'bg-amber-500/10 border-amber-500/30 text-amber-400'\n                                        : 'bg-black/20 border-white/10 text-white/70 hover:text-white hover:border-white/20'\n                                    }`}\n                                  >\n                                    <span onClick={() => selectGroup(group)} className=\"mr-1\">{group.name}</span>\n                                    <button\n                                      type=\"button\"\n                                      onClick={() => deleteGroup(group.name)}\n                                      className=\"w-3.5 h-3.5 flex items-center justify-center rounded-full hover:bg-red-500/20 text-white/30 hover:text-red-400 border-none p-0 cursor-pointer text-[8px] transition-colors\"\n                                      title=\"Delete group\"\n                                    >\n                                      ✕\n                                    </button>\n                                  </div>\n                                );\n                              })\n                            )}\n                          </div>\n                        </div>",
